@page "/"

<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h4" Class="mb-3">BackTester</MudText>

<MudPaper Class="pa-4">
    <MudText Class="mb-3">
        Test a trading strategy on historical prices before risking real money.
        Choose a symbol, a period and a strategy, then look at the performance,
        the drawdown and every trade.
    </MudText>
    <MudText Class="mb-3">
        You can also compare several strategies on the same period, and download a report.
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/config">Start a simulation</MudButton>
</MudPaper>
