@page "/results"
@using ApexCharts
@using BackTester.Web.Services
@inject BacktestState State

<MudText Typo="Typo.h4" Class="mb-4">Résultats</MudText>

@if (_result is null)
{
    <MudPaper Class="pa-4">
        <MudText Class="mb-3">Aucun résultat pour l'instant. Lance d'abord une simulation depuis la page Config.</MudText>
        <MudButton Variant="Variant.Filled" Href="/config">Aller à Config</MudButton>
    </MudPaper>
}
else
{
    <MudText Typo="Typo.subtitle1" Class="mb-3">@_subtitle</MudText>

    <MudGrid Class="mb-4">
        @foreach (var card in Cards)
        {
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.caption">@card.Label</MudText>
                    <MudText Typo="Typo.h6">@card.Value</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudPaper Class="pa-4 mb-4">
        <ApexChart TItem="EquityPoint" Title="Valeur du portefeuille" Height="350" Options="_options">
            <ApexPointSeries TItem="EquityPoint"
                             Items="_curve"
                             Name="Stratégie"
                             SeriesType="SeriesType.Line"
                             XValue="p => p.Date"
                             YValue="p => p.Value" />
        </ApexChart>
    </MudPaper>

    <MudTable Items="@_result.Trades" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Prix</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@context.Date.ToString("dd/MM/yyyy")</MudTd>
            <MudTd DataLabel="Type">@context.Side</MudTd>
            <MudTd DataLabel="Prix">@context.Price.ToString("F2")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Aucun trade sur cette période.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    public record EquityPoint(DateTime Date, decimal Value);

    private BacktestOutput? _result;
    private List<EquityPoint> _curve = new();
    private string _subtitle = "";

    private readonly ApexChartOptions<EquityPoint> _options = new()
    {
        Xaxis = new XAxis { Type = XAxisType.Datetime }
    };

    protected override void OnInitialized()
    {
        _result = State.Last;
        if (_result is null) return;

        _curve = _result.Dates
            .Select((d, i) => new EquityPoint(d, Math.Round(_result.Equity[i], 2)))
            .ToList();

        _subtitle = $"{_result.Request.Strategy} sur {_result.Request.Symbol}, " +
                    $"du {_result.Dates[0]:dd/MM/yyyy} au {_result.Dates[^1]:dd/MM/yyyy}";
    }

    private static string Pct(decimal v) => (v * 100).ToString("F2") + " %";

    private IEnumerable<(string Label, string Value)> Cards => new[]
    {
        ("Rendement cumulé", Pct(_result!.CumulativeReturn)),
        ("Rendement moyen / jour", Pct(_result.AverageDailyReturn)),
        ("Volatilité (journalière)", Pct(_result.Volatility)),
        ("Drawdown max", "-" + Pct(_result.MaxDrawdown)),
        ("Ratio de Sharpe", _result.Sharpe.ToString("F2")),
        ("Nombre de trades", _result.Trades.Count.ToString()),
        ("Buy & Hold", Pct(_result.BuyAndHoldReturn)),
        ("Capital final", _result.Equity[^1].ToString("F2")),
    };
}