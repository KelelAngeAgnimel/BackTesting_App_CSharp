@page "/results"
@using ApexCharts
@using BackTester.Web.Services
@inject BacktestState State

<MudText Typo="Typo.h4" Class="mb-4">Results</MudText>

@if (_result is null)
{
    <MudPaper Class="pa-4">
        <MudText Class="mb-3">No result yet. Run a simulation from the Config page first.</MudText>
        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Href="/config">Go to Config</MudButton>
    </MudPaper>
}
else
{
    <MudText Typo="Typo.subtitle1" Class="mb-3">@_subtitle</MudText>

    <MudGrid Class="mb-4">
        @foreach (var card in Cards)
        {
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.caption">@card.Label</MudText>
                    <MudText Typo="Typo.h6">@card.Value</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudPaper Class="pa-4 mb-4">
        <ApexChart TItem="ChartPoint" Title="Portfolio value" Height="350" Options="_equityOptions">
            <ApexPointSeries TItem="ChartPoint"
                             Items="_equity"
                             Name="Portfolio value"
                             SeriesType="SeriesType.Line"
                             XValue="p => p.Date"
                             YValue="p => p.Value" />
        </ApexChart>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <ApexChart TItem="ChartPoint" Title="Drawdown (%)" Height="300" Options="_drawdownOptions">
            <ApexPointSeries TItem="ChartPoint"
                             Items="_drawdown"
                             Name="Drawdown (%)"
                             SeriesType="SeriesType.Area"
                             XValue="p => p.Date"
                             YValue="p => p.Value" />
        </ApexChart>
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mb-2">Trades</MudText>
    <MudTable Items="@_result.Trades" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>@(_isPair ? "Price A" : "Price")</MudTh>
            @if (_isPair)
            {
                <MudTh>Price B</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@context.Date.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Type">@context.Type</MudTd>
            <MudTd DataLabel="@(_isPair ? "Price A" : "Price")">@context.Price.ToString("F2")</MudTd>
            @if (_isPair)
            {
                <MudTd DataLabel="Price B">@(context.PriceB?.ToString("F2") ?? "-")</MudTd>
            }
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No trades on this period.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    public record ChartPoint(DateTime Date, decimal Value);

    private BacktestOutput? _result;
    private List<ChartPoint> _equity = new();
    private List<ChartPoint> _drawdown = new();
    private string _subtitle = "";
    private bool _isPair;

    private readonly ApexChartOptions<ChartPoint> _equityOptions = new()
    {
        Xaxis = new XAxis { Type = XAxisType.Datetime }
    };

    private readonly ApexChartOptions<ChartPoint> _drawdownOptions = new()
    {
        Xaxis = new XAxis { Type = XAxisType.Datetime }
    };

    protected override void OnInitialized()
    {
        _result = State.Last;
        if (_result is null) return;

        _isPair = _result.Request.SymbolB is not null;

        _equity = _result.Dates
            .Select((d, i) => new ChartPoint(d, Math.Round(_result.Equity[i], 2)))
            .ToList();

        // Drawdown = (running peak - value) / running peak, in %
        var peak = 0m;
        _drawdown = _result.Dates
            .Select((d, i) =>
            {
                var value = _result.Equity[i];
                if (value > peak) peak = value;
                var dd = peak > 0 ? (peak - value) / peak * 100 : 0;
                return new ChartPoint(d, Math.Round(dd, 2));
            })
            .ToList();

        var symbols = _isPair
            ? $"{_result.Request.Symbol} / {_result.Request.SymbolB}"
            : _result.Request.Symbol;
        _subtitle = $"{_result.StrategyName} on {symbols}, " +
                    $"from {_result.Dates[0]:yyyy-MM-dd} to {_result.Dates[^1]:yyyy-MM-dd}";
    }

    // Ratios are fractions: 0.05 is shown as 5.00 %
    private static string Pct(decimal v) => (v * 100).ToString("F2") + " %";

    private IEnumerable<(string Label, string Value)> Cards => new[]
    {
        ("Cumulative return", Pct(_result!.CumulativeReturn)),
        ("Average daily return", Pct(_result.AverageDailyReturn)),
        ("Volatility (daily)", Pct(_result.Volatility)),
        ("Max drawdown", Pct(_result.MaxDrawdown)),
        ("Sharpe ratio (annualized)", _result.Sharpe.ToString("F2")),
        ("Number of trades", _result.TradeCount.ToString()),
        ("Buy & Hold return", _result.BuyAndHoldReturn is { } bh ? Pct(bh) : "n/a"),
        ("Final capital", _result.FinalCapital.ToString("F2")),
    };
}
