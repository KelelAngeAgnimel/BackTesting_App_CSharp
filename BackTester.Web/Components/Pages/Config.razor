@page "/config"
@using BackTester.Web.Data
@using BackTester.Web.Services
@inject BacktestService Backtests
@inject MarketDataService Market
@inject BacktestState State
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Configuration</MudText>

@if (_symbols.Count == 0)
{
    <MudAlert Severity="Severity.Warning">
        No price data is available. Add data on the Data page first.
    </MudAlert>
    return;
}

<MudPaper Class="pa-4">
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudSelect T="string" Label="Strategy" Value="_strategyId" ValueChanged="OnStrategyChanged">
                @foreach (var s in StrategyCatalog.All)
                {
                    <MudSelectItem T="string" Value="@s.Id">@s.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="string" Label="Timeframe" @bind-Value="_timeframe"
                       HelperText="Periods are counted in days (Daily) or in weeks (Weekly).">
                <MudSelectItem T="string" Value="@Timeframes.Daily">Daily</MudSelectItem>
                <MudSelectItem T="string" Value="@Timeframes.Weekly">Weekly</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="@(Strategy.IsPair ? 6 : 12)">
            <MudSelect T="string" Label="@(Strategy.IsPair ? "Symbol A" : "Symbol")"
                       Value="_symbol" ValueChanged="OnSymbolChanged">
                @foreach (var s in _symbols)
                {
                    <MudSelectItem T="string" Value="@s.Symbol">@s.Symbol</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        @if (Strategy.IsPair)
        {
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="Symbol B" @bind-Value="_symbolB">
                    @foreach (var s in _symbols)
                    {
                        <MudSelectItem T="string" Value="@s.Symbol">@s.Symbol</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }

        <MudItem xs="12" sm="6">
            <MudDatePicker Label="Start date" @bind-Date="_start" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudDatePicker Label="End date" @bind-Date="_end" />
        </MudItem>

        <MudItem xs="12" sm="4">
            <MudNumericField T="decimal" Label="Initial capital" @bind-Value="_capital" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="decimal" Label="Transaction fees (%)" @bind-Value="_fees" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="4">
            @if (Strategy.SupportsStopLoss)
            {
                <MudNumericField T="decimal" Label="Stop-loss (%, 0 = none)" @bind-Value="_stopLoss" Min="0" />
            }
            else
            {
                <MudNumericField T="decimal" Label="Stop-loss (%)" Value="0m" Disabled="true"
                                 HelperText="Not available for this strategy." />
            }
        </MudItem>

        @* Strategy fields come from the catalog *@
        @foreach (var p in Strategy.Params)
        {
            var param = p;
            <MudItem xs="12" sm="4">
                <MudNumericField T="decimal" Label="@param.Label"
                                 Value="_params[param.Key]"
                                 ValueChanged="@((decimal v) => _params[param.Key] = v)"
                                 Min="param.Min" />
            </MudItem>
        }

        <MudItem xs="12">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunAsync" Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    <span>Running...</span>
                }
                else
                {
                    <span>Run</span>
                }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private string _strategyId = StrategyCatalog.All[0].Id;
    private string _timeframe = Timeframes.Daily;
    private List<CacheSummary> _symbols = new();
    private string _symbol = "";
    private string _symbolB = "";
    private decimal _capital = 10000;
    private decimal _fees = 0.1m;
    private decimal _stopLoss = 0;
    private DateTime? _start;
    private DateTime? _end;
    private Dictionary<string, decimal> _params = new();
    private bool _loading;

    private StrategyDefinition Strategy => StrategyCatalog.Get(_strategyId);

    protected override void OnInitialized()
    {
        ResetParams();

        _symbols = Market.GetCacheSummaries();
        if (_symbols.Count == 0) return;

        // AAPL / MSFT when available, otherwise the first symbols of the list
        _symbol = Pick("AAPL", 0);
        _symbolB = Pick("MSFT", _symbols.Count > 1 ? 1 : 0);
        SetDefaultPeriod();
    }

    private string Pick(string preferred, int fallbackIndex) =>
        _symbols.Any(s => s.Symbol == preferred) ? preferred : _symbols[fallbackIndex].Symbol;

    private void OnSymbolChanged(string symbol)
    {
        _symbol = symbol;
        SetDefaultPeriod();
    }

    // 2023 by default, moved inside the data of the chosen symbol if needed
    private void SetDefaultPeriod()
    {
        var data = _symbols.First(s => s.Symbol == _symbol);
        var start = new DateTime(2023, 1, 1);
        var end = new DateTime(2024, 1, 1);
        if (start < data.FirstDate || end > data.LastDate)
        {
            end = data.LastDate.Date;
            start = end.AddYears(-1) < data.FirstDate ? data.FirstDate.Date : end.AddYears(-1);
        }
        _start = start;
        _end = end;
    }

    private void OnStrategyChanged(string id)
    {
        _strategyId = id;
        ResetParams();
    }

    // Default values of the chosen strategy
    private void ResetParams() =>
        _params = Strategy.Params.ToDictionary(p => p.Key, p => p.Default);

    // Returns an error message, or null if the form is valid
    private string? Validate()
    {
        if (string.IsNullOrWhiteSpace(_symbol))
            return "Enter a symbol (e.g. AAPL).";
        if (Strategy.IsPair)
        {
            if (string.IsNullOrWhiteSpace(_symbolB))
                return "Enter the second symbol.";
            if (string.Equals(_symbol.Trim(), _symbolB.Trim(), StringComparison.OrdinalIgnoreCase))
                return "The two symbols must be different.";
        }
        if (_start is null || _end is null)
            return "Choose a start date and an end date.";
        if (_start >= _end)
            return "The start date must be before the end date.";
        if (_capital <= 0)
            return "The initial capital must be positive.";
        if (_fees < 0 || _fees >= 100)
            return "The fees must be between 0 and 100 %.";
        if (Strategy.SupportsStopLoss && (_stopLoss < 0 || _stopLoss >= 100))
            return "The stop-loss must be between 0 and 100 %.";

        foreach (var p in Strategy.Params)
        {
            var value = _params[p.Key];
            if (value < p.Min)
                return $"{p.Label} must be at least {p.Min}.";
            if (p.IsInteger && value != decimal.Truncate(value))
                return $"{p.Label} must be a whole number.";
        }
        return Strategy.Validate(_params);
    }

    private async Task RunAsync()
    {
        var error = Validate();
        if (error is not null)
        {
            Snackbar.Add(error, Severity.Warning);
            return;
        }

        _loading = true;
        try
        {
            var request = new BacktestRequest(
                _strategyId, _symbol.Trim().ToUpperInvariant(),
                Strategy.IsPair ? _symbolB.Trim().ToUpperInvariant() : null,
                _timeframe, _start!.Value, _end!.Value,
                _capital, _fees, Strategy.SupportsStopLoss ? _stopLoss : 0,
                new Dictionary<string, decimal>(_params));

            State.Last = await Backtests.RunAsync(request);
            Nav.NavigateTo("/results");
        }
        catch (BacktestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Something went wrong. Please try again.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
