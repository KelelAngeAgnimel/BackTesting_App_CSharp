@page "/config"
@using BackTester.Web.Services
@inject BacktestService Backtests
@inject BacktestState State
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Configuration</MudText>

<MudPaper Class="pa-4">
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudSelect T="string" Label="Stratégie" @bind-Value="_strategy">
                @foreach (var s in _strategies)
                {
                    <MudSelectItem T="string" Value="@s">@s</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField Label="Symbole (ex : AAPL)" @bind-Value="_symbol" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="decimal" Label="Capital initial" @bind-Value="_capital" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="decimal" Label="Frais de transaction (%)" @bind-Value="_fees" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="decimal" Label="Stop-loss (%, 0 = aucun)" @bind-Value="_stopLoss" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="Début" @bind-Date="_start" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="Fin" @bind-Date="_end" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="string" Label="Timeframe" @bind-Value="_timeframe">
                <MudSelectItem T="string" Value="@("Daily")">Daily</MudSelectItem>
                <MudSelectItem T="string" Value="@("Weekly")">Weekly</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudNumericField T="int" Label="Moyenne courte (jours)" @bind-Value="_shortMa" Min="1" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudNumericField T="int" Label="Moyenne longue (jours)" @bind-Value="_longMa" Min="2" />
        </MudItem>
        <MudItem xs="12">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Lancer" Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    <span>Calcul en cours...</span>
                }
                else
                {
                    <span>Lancer</span>
                }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    // D'autres stratégies seront ajoutées quand le moteur les aura
    private readonly string[] _strategies = { "Moving Average Crossover" };

    private string _strategy = "Moving Average Crossover";
    private string _symbol = "AAPL";
    private decimal _capital = 10000;
    private decimal _fees = 0.1m;
    private decimal _stopLoss = 0;
    private DateTime? _start = new DateTime(2023, 1, 1);
    private DateTime? _end = new DateTime(2024, 1, 1);
    private string _timeframe = "Daily";
    private int _shortMa = 20;
    private int _longMa = 50;
    private bool _loading;

    private async Task Lancer()
    {
        if (string.IsNullOrWhiteSpace(_symbol))
        {
            Snackbar.Add("Indique un symbole (ex : AAPL).", Severity.Warning);
            return;
        }
        if (_start is null || _end is null || _start >= _end)
        {
            Snackbar.Add("La date de début doit être avant la date de fin.", Severity.Warning);
            return;
        }
        if (_shortMa >= _longMa)
        {
            Snackbar.Add("La moyenne courte doit être plus petite que la longue.", Severity.Warning);
            return;
        }
        if (_timeframe == "Weekly")
        {
            Snackbar.Add("Le mode Weekly n'est pas encore disponible.", Severity.Info);
            return;
        }

        _loading = true;
        try
        {
            var request = new BacktestRequest(
                _strategy, _symbol.Trim().ToUpperInvariant(), _capital, _fees, _stopLoss,
                _start.Value, _end.Value, _shortMa, _longMa);

            State.Last = await Backtests.RunAsync(request);
            Nav.NavigateTo("/results");
        }
        catch (BacktestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erreur inattendue : " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}